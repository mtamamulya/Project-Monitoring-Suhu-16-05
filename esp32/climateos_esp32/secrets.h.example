/*
 * secrets.h.example — CONTOH isi file rahasia (AMAN di-commit)
 * ============================================================================
 *
 *  CARA PAKAI
 *  1. Salin file ini menjadi "secrets.h" di folder yang sama:
 *       Windows : copy secrets.h.example secrets.h
 *       Mac/Linux: cp secrets.h.example secrets.h
 *  2. Buka secrets.h, isi nilai aslinya (WiFi + kunci perangkat).
 *  3. Flash seperti biasa.
 *
 *  File "secrets.h" sudah masuk .gitignore sehingga TIDAK akan ikut ter-commit
 *  ke GitHub. File contoh ini yang ikut, supaya siapa pun yang meng-clone repo
 *  tahu variabel apa saja yang perlu diisi — tanpa membocorkan nilainya.
 *
 *  KENAPA DIPISAH
 *  Password WiFi rumah sakit dan kunci API perangkat tidak boleh berada di file
 *  yang ter-push ke repositori publik. Kalau bocor, orang luar bisa mengirim
 *  data suhu palsu ke sistem — alarm bisa dibungkam atau dipicu dari jauh.
 *  Memisahkannya ke file yang di-ignore membuat kebocoran itu tidak bisa
 *  terjadi karena tidak sengaja lupa menghapus sebelum commit.
 * ============================================================================
 */

#ifndef SECRETS_H
#define SECRETS_H

// ── DAFTAR JARINGAN WIFI ─────────────────────────────────────────────────────
// Semua jaringan yang tersedia di lokasi pemasangan. Firmware otomatis memilih
// salah satu yang tersedia (WiFiMulti), jadi tidak perlu flash ulang saat unit
// dipindah antar ruangan yang jaringannya berbeda.
//
// Format tiap baris:  { "NAMA_WIFI", "PASSWORD" },
#define WIFI_NETWORKS_LIST                        \
  { "SSID_UTAMA_RSND",   "password_utama" },      \
  { "SSID_CADANGAN_RSND", "password_cadangan" },

// ── KUNCI PERANGKAT ──────────────────────────────────────────────────────────
// HARUS SAMA PERSIS dengan variabel DEVICE_API_KEY di dashboard Render
// (Environment > Add Environment Variable).
//
// Buat nilai acak yang panjang, jangan kata yang mudah ditebak. Contoh cara
// membuatnya di terminal:
//     python -c "import secrets; print(secrets.token_urlsafe(32))"
//
// Nilai ini SAMA untuk ke-6 unit. Yang berbeda antar unit hanya DEVICE_ID,
// dan itu diatur di file .ino, bukan di sini.
#define DEVICE_API_KEY   "isi-dengan-kunci-acak-panjang-dari-render"

#endif  // SECRETS_H
